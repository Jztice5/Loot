# Application runtime connection. Use the non-DDL loot_app role.
LOOT_DATABASE_URL=postgresql+psycopg://loot_app:<password>@<host>:5432/loot_dev

# Alembic migration connection. Use only for schema migrations.
LOOT_MIGRATION_DATABASE_URL=postgresql+psycopg://loot_migrator:<password>@<host>:5432/loot_dev

# Integration tests must target loot_test, never loot_dev.
LOOT_TEST_DATABASE_URL=postgresql+psycopg://loot_app:<password>@<host>:5432/loot_test
LOOT_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://loot_migrator:<password>@<host>:5432/loot_test
