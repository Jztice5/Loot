# Local development defaults to loot_test and always uses the non-DDL loot_app role.
LOOT_DATABASE_URL=postgresql+psycopg://loot_app:<password>@<host>:5432/loot_test

# Integration tests must target loot_test, never loot_dev.
LOOT_TEST_DATABASE_URL=postgresql+psycopg://loot_app:<password>@<host>:5432/loot_test
